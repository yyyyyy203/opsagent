{
  "name": "inspection-diagnosis-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "acceptance:memory": "pnpm build && node apps/acceptance/memory.mjs",
    "acceptance:real-model": "pnpm build && node apps/acceptance/real-model.mjs",
    "acceptance:trace-probe": "pnpm build && node apps/acceptance/trace-probe.mjs",
    "acceptance:review": "pnpm build && node apps/acceptance/review.mjs",
    "lint": "eslint . --ignore-pattern apps/logs-lab/index.mjs",
    "lab:backend:up": "docker compose -p agentops-metrics -f infrastructure/metrics-lab/compose.yaml up -d",
    "lab:backend:stop": "docker compose -p agentops-metrics -f infrastructure/metrics-lab/compose.yaml stop",
    "lab:start": "pnpm build && node apps/metrics-lab/index.mjs",
    "logs:backend:up": "docker compose -p agentops-logs -f infrastructure/logs-lab/compose.yaml up -d",
    "logs:backend:stop": "docker compose -p agentops-logs -f infrastructure/logs-lab/compose.yaml stop",
    "logs:lab": "pnpm build && node apps/logs-lab/index.mjs",
    "test": "pnpm build && vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:server": "pnpm build && node apps/agent-server/index.mjs",
    "web:dev": "pnpm --dir apps/agent-web dev",
    "web:build": "pnpm --dir apps/agent-web build",
    "web:typecheck": "pnpm --dir apps/agent-web typecheck",
    "e2e": "pnpm build && pnpm web:build && playwright test",
    "e2e:multi-target": "pnpm build && pnpm web:build && node ./node_modules/@playwright/test/cli.js test --config=playwright.multi-target.config.ts",
    "acceptance:multi-target-capacity": "pnpm build && AGENTOPS_RUN_CAPACITY_ACCEPTANCE=1 pnpm exec vitest run test/multi-target-capacity.test.ts",
    "acceptance:multi-target-load": "pnpm build && AGENTOPS_RUN_MULTI_TARGET_LOAD=1 pnpm exec vitest run test/multi-target-load.test.ts",
    "e2e:circuit": "node ./node_modules/typescript/bin/tsc -p ./tsconfig.build.json && node ./apps/agent-web/node_modules/vite/bin/vite.js build ./apps/agent-web && node ./node_modules/@playwright/test/cli.js test --config=./playwright.circuit.config.ts",
    "e2e:circuit:prometheus": "node ./node_modules/typescript/bin/tsc -p ./tsconfig.build.json && node ./apps/agent-web/node_modules/vite/bin/vite.js build ./apps/agent-web && node ./node_modules/@playwright/test/cli.js test --config=./playwright.prometheus-circuit.config.ts",
    "logs:e2e": "pnpm build && pnpm web:build && playwright test --config=playwright.logs.config.ts",
    "acceptance:memory-vector": "pnpm build && node apps/acceptance/memory-vector.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.2.0",
    "langsmith": "^0.3.74",
    "openai": "^6.49.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.55.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
